{
  "functions": {
    "bizkaibus_metro+/api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/bizkaibus_metro+/api/index.php" },
    { "source": "/", "destination": "/bizkaibus_metro+/api/shell.php" },
    { "source": "/(.*)", "destination": "/bizkaibus_metro+/$1" }
  ]
}
