{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.php" },
    { "source": "/lines/(.*)", "destination": "/api/shell.php" },
    { "source": "/stops/(.*)", "destination": "/api/shell.php" },
    { "source": "/", "destination": "/api/shell.php" }
  ]
}
